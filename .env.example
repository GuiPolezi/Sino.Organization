# Copie para .env (que não vai para o git) e preencha.
# Chave da API do Milldesk, usada só pelos scripts `npm run sync:clients`, `npm run sync:team`,
# `npm run sync:atendimentos` e `npm run sync:chamados`.
MILLDESK_API_KEY=

# Usuário e senha do Sino.Licença (licenca.sinoinformatica.com.br), usados só pela
# API do servidor (/api/licencas). O site não tem API: o servidor entra com eles e lê
# as tabelas da página inicial. Use um usuário só de consulta, se possível.
LICENCA_USUARIO=
LICENCA_SENHA=

# Supabase, onde a API guarda o cache das fontes (tabela criada por
# supabase/migrations/0001_cache.sql). Dashboard > Project Settings > API:
# URL do projeto e a chave secreta (sb_secret_... ou a antiga service_role).
# Nunca use estas variáveis no navegador nem com prefixo VITE_.
# Sem elas, em desenvolvimento o cache fica só na memória.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
