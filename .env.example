# Copie para .env (que não vai para o git) e preencha.
# Chave da API do Milldesk, usada só pelos scripts `npm run sync:clients`, `npm run sync:team`,
# `npm run sync:atendimentos` e `npm run sync:chamados`.
MILLDESK_API_KEY=

# Usuário e senha do Sino.Licença (licenca.sinoinformatica.com.br), usados só pelo
# script `npm run sync:licencas`. O site não tem API: o script entra com eles e lê
# as tabelas da página inicial. Use um usuário só de consulta, se possível.
LICENCA_USUARIO=
LICENCA_SENHA=
